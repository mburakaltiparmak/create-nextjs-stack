# ─── Giriş (Auth.js) ───────────────────────────────────────────────────────────
# Rastgele bir secret üretin:  npx auth secret
AUTH_SECRET=your-random-auth-secret
# Vercel dışında (`next start`, Docker, Railway…) Auth.js her girişi "UntrustedHost" ile reddeder.
# true bırakın ya da AUTH_URL=https://admin.yourdomain.com verin.
AUTH_TRUST_HOST=true
# Tek yönetici. Production'da ADMIN_PASSWORD_HASH kullanın:  npm run auth:hash -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Yalnız yerel geliştirme için düz metin (hash varsa yok sayılır)
ADMIN_PASSWORD=change-me
