# ─── Supabase ──────────────────────────────────────────────────────────────────
# https://supabase.com → Project Settings → API. Panel service role anahtarıyla yazar (yalnız sunucuda).
# Şema: supabase/schema.sql (SQL Editor'de çalıştırın), örnek içerik: supabase/seed.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudinary (görsel yükleme) ──────────────────────────────────────────────
# https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=admin_uploads

# ─── Önbellek tazeleme ─────────────────────────────────────────────────────────
# web/ uygulamasındaki REVALIDATION_SECRET ile aynı; yayından sonra site önbelleği hemen tazelenir
REVALIDATION_SECRET=
