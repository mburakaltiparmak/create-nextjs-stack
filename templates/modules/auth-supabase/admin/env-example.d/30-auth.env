# ─── Giriş (Supabase Auth) ─────────────────────────────────────────────────────
# Kullanıcıları Supabase → Authentication → Users'tan ekleyin (e-posta + şifre). Yalnız bu listedeki
# e-postalar panele girebilir (virgülle ayırın). Anahtarlar yukarıdaki NEXT_PUBLIC_SUPABASE_* değerleridir.
ADMIN_EMAILS=admin@example.com
