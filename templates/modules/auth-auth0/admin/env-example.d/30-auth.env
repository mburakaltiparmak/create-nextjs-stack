# ─── Giriş (Auth0: roller, davetler, MFA) ──────────────────────────────────────
# Kurulum: AUTH0.md. Regular Web Application → Allowed Callback URL: <APP_BASE_URL>/auth/callback,
# Allowed Logout URL: <APP_BASE_URL>. AUTH0_SECRET: `openssl rand -hex 32`.
APP_BASE_URL=http://localhost:3001
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# Custom domain kullanılıyorsa AUTH0_DOMAIN onu, bu değişken tenant adresini gösterir (Management API için).
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Machine-to-Machine uygulaması → Auth0 Management API (read/create/update users, roles, tickets, sessions)
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Post Login Action (auth0/actions/add-claims.js) ile aynı namespace
AUTH0_ROLES_CLAIM=https://example.com/roles
AUTH0_SITE_KEYS_CLAIM=https://example.com/siteKeys
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
# Auth0 → User Management → Roles: editor, publisher, administrator rollerinin ID'leri
AUTH0_ROLE_EDITOR_ID=
AUTH0_ROLE_PUBLISHER_ID=
AUTH0_ROLE_ADMINISTRATOR_ID=

# ─── E-posta (kullanıcı davetleri) ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Admin <noreply@example.com>
