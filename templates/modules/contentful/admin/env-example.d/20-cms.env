# ─── Contentful ────────────────────────────────────────────────────────────────
# https://app.contentful.com → Settings → API keys. Model kurulumu: npm run contentful:setup (+ contentful:seed)
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_ENVIRONMENT=master
# Content management token — panel okuma ve yazma işlerini bununla yapar.
# Profil → Account settings → CMA tokens → Create personal access token (CFPAT-...).
# Space → API keys'teki Delivery/Preview token'ları burada çalışmaz.
CONTENTFUL_MANAGEMENT_TOKEN=your-content-management-token
# Space'in varsayılan locale'i en-US değilse (contentful:setup söyler)
# CONTENTFUL_LOCALE=en-US
