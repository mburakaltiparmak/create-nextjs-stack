# ─── Contentful ────────────────────────────────────────────────────────────────
# https://app.contentful.com → Settings → API keys
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_ENVIRONMENT=master

# Content management token — admin paneli okuma ve yazma işlerini bununla yapar.
# Settings → API keys → Content management tokens → Generate personal token
CONTENTFUL_MANAGEMENT_TOKEN=your-content-management-token

# ─── Auth.js ───────────────────────────────────────────────────────────────────
# Rastgele bir secret üret:  npx auth secret
AUTH_SECRET=your-random-auth-secret

# Yönetici girişi. Production'da ADMIN_PASSWORD_HASH kullan:
#   npm run auth:hash -- "your-password"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=

# Sadece yerel geliştirme için düz metin alternatifi (hash varsa yok sayılır).
ADMIN_PASSWORD=change-me

# ─── Cloudinary (görsel yüklemeleri) ──────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
