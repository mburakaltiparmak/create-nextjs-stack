# ─── Contentful ────────────────────────────────────────────────────────────────
# https://app.contentful.com → Settings → API keys
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=your_content_delivery_api_token_here
CONTENTFUL_PREVIEW_TOKEN=your_content_preview_api_token_here

# Content management token — sadece `contentful:setup` ve `contentful:types` için
# Settings → API keys → Content management tokens
CONTENTFUL_MANAGEMENT_TOKEN=your_content_management_token_here

# ─── Draft Mode & Webhooks ────────────────────────────────────────────────────
# Contentful → Settings → Content preview
#   https://<site>/api/preview?secret=<CONTENTFUL_PREVIEW_SECRET>&slug=/products/{entry.fields.slug}
CONTENTFUL_PREVIEW_SECRET=your_random_secret_string_here

# Contentful → Settings → Webhooks → header: x-contentful-webhook-secret
CONTENTFUL_WEBHOOK_SECRET=your_random_secret_string_here

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=hello@yourdomain.com

# ─── Cloudinary ────────────────────────────────────────────────────────────────
# https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# ─── Revalidation ─────────────────────────────────────────────────────────────
# Genel amaçlı /api/revalidate rotası için (tag/path gövdesiyle manuel tetikleme)
REVALIDATION_SECRET=your_random_secret_string_here
