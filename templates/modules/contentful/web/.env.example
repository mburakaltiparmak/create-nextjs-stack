# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=My Site
# Production: https://www.example.com — canonical ve sitemap adresleri buradan üretilir
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Contentful ────────────────────────────────────────────────────────────────
# https://app.contentful.com → Settings → API keys. Model admin'de: npm run contentful:setup
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=your_content_delivery_api_token_here
CONTENTFUL_PREVIEW_TOKEN=your_content_preview_api_token_here
# Space'in varsayılan locale'i en-US değilse
# CONTENTFUL_LOCALE=en-US

# İletişim formu talepleri `lead` kaydı olarak yazılır (admin → Talepler). Tercihen yalnız `lead` kayıtlarını
# oluşturup düzenleyebilen bir rolün CMA token'ı; boşsa CONTENTFUL_MANAGEMENT_TOKEN kullanılır (contentful:types da ister).
CONTENTFUL_LEAD_MANAGEMENT_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=

# ─── Önizleme ve önbellek ──────────────────────────────────────────────────────
# Admin'deki PREVIEW_SECRET ile aynı (`openssl rand -hex 32`); admin "Önizle" bu sırla imzalar
PREVIEW_SECRET=
# Contentful → Settings → Webhooks → https://<site>/api/revalidate/contentful,
# header x-contentful-webhook-secret = bu değer, tetikleyici: Entry publish / unpublish / delete
CONTENTFUL_WEBHOOK_SECRET=
# Genel amaçlı /api/revalidate (tag/path gövdesiyle elle tetikleme)
REVALIDATION_SECRET=

# ─── İletişim formu (Resend) ───────────────────────────────────────────────────
# https://resend.com → API Keys. Boşsa talepler yalnız admin'e (Talepler) düşer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=website@example.com
CONTACT_EMAIL=hello@example.com
