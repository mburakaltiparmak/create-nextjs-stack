{
  "name": "contentful",
  "label": "Contentful",
  "kind": "cms",
  "description": "Swaps the Supabase data layer for Contentful. Web reads through the Content Delivery API (Preview API in draft mode); the admin writes through the Content Management API with drafts, publishing and a media library.",
  "targets": {
    "web": {
      "remove": [
        "src/lib/supabase",
        "supabase"
      ],
      "dependencies": {
        "contentful": "^11.5.16"
      },
      "devDependencies": {
        "cf-content-types-generator": "^2.15.5",
        "contentful-migration": "^4.32.0"
      },
      "removeDependencies": [
        "@supabase/ssr",
        "@supabase/supabase-js"
      ],
      "scripts": {
        "contentful:types": "node --env-file-if-exists=.env contentful/generate-types.mjs"
      }
    },
    "admin": {
      "remove": [
        "supabase",
        "src/lib/cloudinary.ts",
        "src/components/content/CloudinaryImage.tsx"
      ],
      "devDependencies": {
        "contentful-management": "^11.76.0",
        "contentful-migration": "^4.32.0"
      },
      "removeDependencies": [
        "@supabase/supabase-js"
      ],
      "scripts": {
        "contentful:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local contentful/setup.mjs",
        "contentful:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local contentful/seed.mjs"
      }
    }
  }
}
