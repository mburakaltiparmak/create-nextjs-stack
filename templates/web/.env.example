# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=My Site
# Production: https://www.example.com — canonical ve sitemap adresleri buradan üretilir
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────────────────
# https://supabase.com → Project Settings → API. Şema admin/supabase/schema.sql'dedir.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Yalnız sunucuda: önizlemede taslakları okumak ve iletişim formu taleplerini kaydetmek için
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Önizleme ve önbellek ──────────────────────────────────────────────────────
# Admin'deki PREVIEW_SECRET ile aynı (`openssl rand -hex 32`); admin "Önizle" bu sırla imzalar
PREVIEW_SECRET=
# Admin'deki REVALIDATION_SECRET ile aynı; yayından sonra admin /api/revalidate'i çağırır
REVALIDATION_SECRET=

# ─── İletişim formu (Resend) ───────────────────────────────────────────────────
# https://resend.com → API Keys. Boşsa talepler yalnız admin'e (Talepler) düşer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=website@example.com
CONTACT_EMAIL=hello@example.com
